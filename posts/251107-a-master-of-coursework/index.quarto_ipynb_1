      "source": [
        "#| eval: false\n",
        "#| echo: false\n",
        "\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "# Read and process a complete export from the solidtime instance, not uploaded to repo as you probably don't need all of it.\n",
        "\n",
        "data_frames = {}\n",
        "for filename in Path('data').glob('*.csv'):\n",
        "    data_frames[filename.stem] = pd.read_csv(filename)\n",
        "    print(f\"Loaded {filename} with shape {data_frames[filename.stem].shape}\")\n",
        "\n",
        "time_entries = data_frames.get('time_entries')\n",
        "\n",
        "client_id_to_name = data_frames.get('clients').set_index('id')['name'].to_dict()\n",
        "project_id_to_name = data_frames.get('projects').set_index('id')['name'].to_dict()\n",
        "tasks_id_to_name = data_frames.get('tasks').set_index('id')['name'].to_dict()\n",
        "\n",
        "time_entries['client'] = time_entries['client_id'].map(\n",
        "    lambda x: client_id_to_name.get(x, 'Unknown Client')\n",
        ")\n",
        "time_entries['project'] = time_entries['project_id'].map(\n",
        "    lambda x: project_id_to_name.get(x, 'Unknown Project')\n",
        ")\n",
        "time_entries['task'] = time_entries['task_id'].map(\n",
        "    lambda x: tasks_id_to_name.get(x, 'Unknown Task')\n",
        ")\n",
        "\n",
        "time_entries['duration'] = time_entries.apply(\n",
        "    lambda row: pd.to_datetime(row['end']) - pd.to_datetime(row['start']),\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "time_entries['day'] = pd.to_datetime(time_entries['start']).dt.date\n",
        "\n",
        "time_entries['trimester'] = time_entries['project'].apply(\n",
        "    lambda x: 'T12025' if x in ['AIML420', 'AIML427', 'AIML428', 'AIML440'] else 'T22025'\n",
        ")\n",
        "\n",
        "time_entries = time_entries[['client', 'project', 'task', 'day', 'duration', 'description', 'trimester']]\n",
        "\n",
        "# Only VUW MAI\n",
        "time_entries = time_entries[time_entries['client'] == 'VUW MAI']\n",
        "# Drop AIML501 and AIML589\n",
        "time_entries = time_entries[~time_entries['project'].isin(['AIML501', 'AIML589'])]\n",
        "time_entries.sort_values(by='day').to_csv('processed_time_entries.csv', index=False)\n",
        "time_entries"
      ],
